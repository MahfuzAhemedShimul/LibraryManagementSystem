@model LibraryManagementSystem.Models.ApplicationUser

@{
    ViewData["Title"] = "Member Details";
    var borrowings = ViewBag.Borrowings as List<LibraryManagementSystem.Models.Borrowing>;
}

<h1>Member Details</h1>

<dl class="row">
    <dt class="col-sm-2">Full Name</dt>
    <dd class="col-sm-10">@Model.FullName</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
</dl>

<h3>Borrowing History</h3>

@if (borrowings == null || !borrowings.Any())
{
    <p><em>No borrowing history yet.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Book</th>
                <th>Issue Date</th>
                <th>Due Date</th>
                <th>Return Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in borrowings)
            {
                <tr>
                    <td>@b.Book?.Title</td>
                    <td>@b.IssueDate.ToShortDateString()</td>
                    <td>@b.DueDate.ToShortDateString()</td>
                    <td>@(b.ReturnDate.HasValue ? b.ReturnDate.Value.ToShortDateString() : "-")</td>
                    <td>@b.Status</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3"><a asp-action="Index">Back to List</a></div>