@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center text-muted mb-3">
    <i class="bi bi-clock"></i> <span id="liveDateTime"></span>
</div>

<div class="row justify-content-center mb-4">
    <div class="col-md-6">
        <form asp-controller="Books" asp-action="Index" method="get" class="d-flex">
            <input type="text" name="searchString" class="form-control me-2" placeholder="Search for a book by title or ISBN..." />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Search
            </button>
        </form>
    </div>
</div>

@if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Librarian")))
{
    <h1>@(User.IsInRole("Admin") ? "Admin" : "Librarian") Dashboard</h1>
    <div class="row mt-4">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Books</h5>
                    <p class="card-text display-6">@ViewBag.TotalBooks</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Total Members</h5>
                    <p class="card-text display-6">@ViewBag.TotalMembers</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Active Borrowings</h5>
                    <p class="card-text display-6">@ViewBag.ActiveBorrowings</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-danger">
                <div class="card-body">
                    <h5 class="card-title">Overdue Books</h5>
                    <p class="card-text display-6">@ViewBag.OverdueCount</p>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Unpaid Fines Total</h5>
                    <p class="card-text display-6">@("৳" + ((decimal)ViewBag.UnpaidFinesTotal).ToString("N2"))</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-secondary">
                <div class="card-body">
                    <h5 class="card-title">Pending Requests</h5>
                    <p class="card-text display-6">@ViewBag.PendingRequestsCount</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
        {
            <a asp-controller="Books" asp-action="Create" class="btn btn-primary">Add New Book</a>
        }
        <a asp-controller="Borrowings" asp-action="PendingRequests" class="btn btn-secondary">Review Requests</a>
        <a asp-controller="Borrowings" asp-action="Issue" class="btn btn-secondary">Issue a Book</a>
        <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary">View Reports</a>
    </div>
}
else if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Staff"))
{
    <h1>Staff Dashboard</h1>
    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-secondary">
                <div class="card-body">
                    <h5 class="card-title">Pending Requests</h5>
                    <p class="card-text display-6">@ViewBag.PendingRequestsCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Unpaid Fines</h5>
                    <p class="card-text display-6">@ViewBag.UnpaidFinesCount</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Borrowings" asp-action="PendingRequests" class="btn btn-primary">Review Requests</a>
        <a asp-controller="Borrowings" asp-action="Issue" class="btn btn-secondary">Issue a Book</a>
        <a asp-controller="Fines" asp-action="Index" class="btn btn-outline-secondary">Collect Fines</a>
    </div>
}
else if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Member"))
{
    <h1>My Dashboard</h1>

    <h4 class="mt-4">My Pending Requests</h4>
    @if (((List<LibraryManagementSystem.Models.Borrowing>)ViewBag.MyPendingRequests).Count == 0)
    {
        <p><em>No pending requests.</em></p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>Book</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var r in (List<LibraryManagementSystem.Models.Borrowing>)ViewBag.MyPendingRequests)
                {
                    <tr>
                        <td>@r.Book?.Title</td>
                        <td>Awaiting Approval</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h4 class="mt-4">My Active Borrowings</h4>
    @if (((List<LibraryManagementSystem.Models.Borrowing>)ViewBag.MyActiveBorrowings).Count == 0)
    {
        <p><em>You have no books currently borrowed.</em></p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>Book</th><th>Due Date</th></tr>
            </thead>
            <tbody>
                @foreach (var b in (List<LibraryManagementSystem.Models.Borrowing>)ViewBag.MyActiveBorrowings)
                {
                    <tr>
                        <td>@b.Book?.Title</td>
                        <td>@b.DueDate.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h4 class="mt-4">My Unpaid Fines</h4>
    @if (((List<LibraryManagementSystem.Models.Fine>)ViewBag.MyUnpaidFines).Count == 0)
    {
        <p><em>You have no unpaid fines.</em></p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>Book</th><th>Amount</th></tr>
            </thead>
            <tbody>
                @foreach (var f in (List<LibraryManagementSystem.Models.Fine>)ViewBag.MyUnpaidFines)
                {
                    <tr>
                        <td>@f.Borrowing?.Book?.Title</td>
                        <td>@("৳" + f.Amount.ToString("N2"))</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-3">
        <a asp-controller="Books" asp-action="Index" class="btn btn-primary">Browse Books</a>
        <a asp-controller="Chat" asp-action="Index" class="btn btn-outline-secondary">Ask the Assistant</a>
    </div>
}
else
{
    <div class="text-center py-5 home-hero-bg">
        <h1 class="display-4">Welcome to the MAS Library BD-MLB</h1>
        <p class="lead text-muted">Read More, Learn Faster, Grow Further.</p>
        <div class="mt-4 d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Books" asp-action="Index" class="btn btn-primary btn-lg px-4 py-3 shadow-sm">
                <i class="bi bi-book"></i> Browse Books
            </a>
            <a asp-controller="Home" asp-action="BecomeAMember" class="btn btn-success btn-lg px-4 py-3 shadow-sm">
                <i class="bi bi-person-plus"></i> Become a Member
            </a>
        </div>
    </div>
}

@section Scripts {
    <script>
        function updateLiveDateTime() {
            const now = new Date();
            const options = {
                weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
                hour: '2-digit', minute: '2-digit', second: '2-digit'
            };
            document.getElementById('liveDateTime').textContent = now.toLocaleString('en-US', options);
        }
        updateLiveDateTime();
        setInterval(updateLiveDateTime, 1000);
    </script>
}