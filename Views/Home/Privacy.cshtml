@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">

    <!-- Header -->
    <div class="text-center mb-5">
        <div class="bg-primary text-white rounded-4 shadow-lg p-5">
            <h1 class="display-5 fw-bold">
                <i class="bi bi-shield-lock-fill"></i> Privacy Policy
            </h1>
            <p class="lead mb-0">
                Your privacy and the security of your library information are our highest priorities.
            </p>
        </div>
    </div>

    <!-- Content -->
    <div class="card border-0 shadow-lg rounded-4">

        <div class="card-body p-5">

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="border rounded-4 p-4 h-100">
                        <h4 class="text-primary">
                            🔒 Information We Collect
                        </h4>
                        <ul class="mt-3">
                            <li>Full Name</li>
                            <li>Student / Member ID</li>
                            <li>Email Address</li>
                            <li>Phone Number</li>
                            <li>Borrowing History</li>
                            <li>Login Activity</li>
                        </ul>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded-4 p-4 h-100">
                        <h4 class="text-success">
                            📚 How We Use Your Information
                        </h4>

                        <ul class="mt-3">
                            <li>Manage library accounts</li>
                            <li>Issue and return books</li>
                            <li>Track due dates</li>
                            <li>Send reminders</li>
                            <li>Improve library services</li>
                            <li>Maintain system security</li>
                        </ul>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded-4 p-4 h-100">
                        <h4 class="text-warning">
                            🛡 Data Security
                        </h4>

                        <p class="mt-3">
                            We use secure authentication, encrypted passwords,
                            authorized access, and regular backups to protect your
                            information from unauthorized access or misuse.
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded-4 p-4 h-100">
                        <h4 class="text-danger">
                            🤝 Information Sharing
                        </h4>

                        <p class="mt-3">
                            Your personal information is never sold or shared with
                            third parties except where required by law or approved
                            by library administration.
                        </p>
                    </div>
                </div>

                <div class="col-12">
                    <div class="border rounded-4 p-4">
                        <h4 class="text-info">
                            👤 Your Rights
                        </h4>

                        <div class="row mt-3">

                            <div class="col-md-3 mb-3">
                                <div class="card border-primary text-center h-100">
                                    <div class="card-body">
                                        <h5>View</h5>
                                        <small>Access your personal information.</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3">
                                <div class="card border-success text-center h-100">
                                    <div class="card-body">
                                        <h5>Edit</h5>
                                        <small>Update incorrect information.</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3">
                                <div class="card border-warning text-center h-100">
                                    <div class="card-body">
                                        <h5>Password</h5>
                                        <small>Change your password anytime.</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3">
                                <div class="card border-danger text-center h-100">
                                    <div class="card-body">
                                        <h5>Support</h5>
                                        <small>Contact library administration.</small>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="bg-light rounded-4 p-4">
                        <h4 class="text-dark">
                            📞 Contact Us
                        </h4>

                        <p class="mb-1">
                            <strong>MAS Library BD-MLB</strong>
                        </p>

                        <p class="mb-1">
                            Email: mahfuzshimul01@gmail.com
                        </p>

                        <p class="mb-1">
                            Phone: +8801625416012
                        </p>

                        <p class="mb-0">
                            Last Updated: August 6, 2026
                        </p>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>