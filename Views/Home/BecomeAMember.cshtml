@{
    ViewData["Title"] = "Become a Member";
}

<h1>Become a Member</h1>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">General Instructions</h5>
        <ol class="mb-0">
            <li>The users are requested to observe the opening and closing hours of the library.</li>
            <li>The library furniture, tools, books etc. should not be damaged.</li>
            <li>Drinks and eatables are not allowed in the library. Using mobile phones is not permitted inside the library. Users in sleeping dress are not allowed to enter the library.</li>
            <li>All users should follow the rules and regulations. If a student does not follow the rules, then his name may be sent to the Disciplinary Committee.</li>
        </ol>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Necessary Documents Needed</h5>
        <ol class="mb-0">
            <li>Valid National ID / Passport / DOB attested photocopy with current residence address</li>
            <li>Two passport size photos, attested</li>
        </ol>
    </div>
</div>

<div class="alert alert-info">
    <i class="bi bi-info-circle"></i>
    Please visit the library in person or contact library staff with the documents above to complete your membership registration.
</div>