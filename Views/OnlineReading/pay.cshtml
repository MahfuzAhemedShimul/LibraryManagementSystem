@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Pay for Online Reading";
}

<h1>Pay for Online Reading</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<dl class="row">
    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>
    <dt class="col-sm-3">Author</dt>
    <dd class="col-sm-9">@Model.Author?.Name</dd>
    <dt class="col-sm-3">Online Reading Price</dt>
    <dd class="col-sm-9">@("৳" + Model.OnlineReadingPrice.ToString("N2"))</dd>
</dl>

<form asp-action="Pay" method="post" id="paymentForm">
    <input type="hidden" name="id" value="@Model.BookId" />

    <div class="form-group mb-3">
        <label for="paymentMethod">Payment Method</label>
        <select name="paymentMethod" id="paymentMethod" class="form-control" required>
            <option value="Card">Card</option>
            <option value="Mobile Banking">Mobile Banking</option>
        </select>
    </div>

    <!-- Mobile Banking demo fields -->
    <div id="mobileBankingFields" class="payment-demo-fields d-none">
        <div class="card card-body bg-light mb-3">
            <h6 class="text-muted mb-3"><i class="bi bi-phone"></i> Mobile Banking Details</h6>

            <div class="form-group mb-2">
                <label>Account Holder Name</label>
                <input type="text" class="form-control" placeholder="e.g. Rizvi Khan" />
            </div>

            <div class="form-group mb-2">
                <label>Mobile Number</label>
                <input type="text" class="form-control" placeholder="01XXXXXXXXX" maxlength="11" />
            </div>

            <div class="form-group mb-2">
                <label>Amount</label>
                <input type="text" class="form-control" maxlength="11" />
            </div>

            <div class="form-group mb-2">
                <label>Password</label>
                <input type="text" class="form-control" maxlength="11" />
            </div>
        </div>
    </div>

    <!-- Card demo fields -->
    <div id="cardFields" class="payment-demo-fields d-none">
        <div class="card card-body bg-light mb-3">
            <h6 class="text-muted mb-3"><i class="bi bi-credit-card"></i> Card Details</h6>

            <div class="form-group mb-2">
                <label>Cardholder Name</label>
                <input type="text" class="form-control" placeholder="e.g. Rizvi Khan" />
            </div>

            <div class="form-group mb-2">
                <label>Bank Name</label>
                <input type="text" class="form-control" placeholder="e.g. Dutch-Bangla Bank" />
            </div>

            <div class="form-group mb-2">
                <label>Card ID / Number</label>
                <input type="text" class="form-control" placeholder="XXXX XXXX XXXX XXXX" maxlength="19" />
            </div>

            <div class="form-group mb-2">
                <label>PIN</label>
                <input type="password" class="form-control" placeholder="••••" maxlength="4" />
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-success">Confirm Payment</button>
    <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <script>
        const paymentMethodSelect = document.getElementById('paymentMethod');
        const mobileBankingFields = document.getElementById('mobileBankingFields');
        const cardFields = document.getElementById('cardFields');

        function togglePaymentFields() {
            const selected = paymentMethodSelect.value;

            mobileBankingFields.classList.add('d-none');
            cardFields.classList.add('d-none');

            if (selected === 'Mobile Banking') {
                mobileBankingFields.classList.remove('d-none');
            } else if (selected === 'Card') {
                cardFields.classList.remove('d-none');
            }
        }

        paymentMethodSelect.addEventListener('change', togglePaymentFields);
        togglePaymentFields();
    </script>
}