@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Read Online";
    bool isUrl = Uri.TryCreate(Model.PdfContent, UriKind.Absolute, out var uriResult)
                 && (uriResult.Scheme == Uri.UriSchemeHttp || uriResult.Scheme == Uri.UriSchemeHttps);
    string pdfSrc = isUrl ? Model.PdfContent + "#toolbar=0&navpanes=0" : "";
    DateTime? expiry = ViewBag.ExpiryDate as DateTime?;
}

<h1>@Model.Title</h1>
<p class="text-muted">@Model.Author?.Name</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (expiry.HasValue)
{
    var daysLeft = (expiry.Value.Date - DateTime.Today).Days;
    <div class="alert alert-info py-2">
        Access expires on <strong>@expiry.Value.ToString("MMM d, yyyy")</strong> (@daysLeft day@(daysLeft == 1 ? "" : "s") left)
    </div>
}

<div class="alert alert-warning py-2 small">
    This content is for your personal reading only. Copying, printing, and downloading are disabled.
</div>

<div class="card position-relative protected-reader" oncontextmenu="return false;">
    <div class="watermark-overlay">
        @User.Identity!.Name
    </div>
    <div class="card-body">
        @if (isUrl)
        {
            <iframe src="@pdfSrc" style="width:100%; height:80vh; border:none;"></iframe>
        }
        else
        {
            <div class="protected-text">@Model.PdfContent</div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-secondary">Back to Book</a>
</div>

<style>
    .protected-reader {
        user-select: none;
        -webkit-user-select: none;
        -ms-user-select: none;
    }

    .protected-text {
        white-space: pre-wrap;
    }

    .watermark-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        pointer-events: none;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: rgba(0, 0, 0, 0.08);
        transform: rotate(-30deg);
        overflow: hidden;
        white-space: nowrap;
    }

    @@media print {
        body * {
            visibility: hidden !important;
        }
    }
</style>

@section Scripts {
    <script>
        const reader = document.querySelector('.protected-reader');

        reader.addEventListener('copy', e => e.preventDefault());
        reader.addEventListener('cut', e => e.preventDefault());
        reader.addEventListener('contextmenu', e => e.preventDefault());
        reader.addEventListener('dragstart', e => e.preventDefault());

        document.addEventListener('keydown', function (e) {
            const key = e.key.toLowerCase();
            const blockCombo = (e.ctrlKey || e.metaKey) && ['s', 'p', 'c', 'u'].includes(key);
            if (blockCombo || e.key === 'PrintScreen') {
                e.preventDefault();
            }
        });
    </script>
}