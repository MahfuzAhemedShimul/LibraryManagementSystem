@model IEnumerable<LibraryManagementSystem.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
{
    <p><a asp-action="Create" class="btn btn-primary">Add New Book</a></p>
}

@if (User.Identity == null || !User.Identity.IsAuthenticated)
{
    <div class="alert alert-info">
        You need to be a registered member to buy or borrow a book.
        <a asp-controller="Account" asp-action="Register">Register here</a> or
        <a asp-controller="Account" asp-action="Login">log in</a> if you already have an account.
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Category</th>
            @if (User.IsInRole("Admin") || User.IsInRole("Librarian") || User.IsInRole("Staff"))
            {
                <th>ISBN</th>
                <th>Total Copies</th>
                <th>Available Copies</th>
            }
            <th>Price</th>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Author?.Name</td>
                <td>@item.Category?.Name</td>
                @if (User.IsInRole("Admin") || User.IsInRole("Librarian") || User.IsInRole("Staff"))
                {
                    <td>@item.ISBN</td>
                    <td>@item.TotalCopies</td>
                    <td>@item.AvailableCopies</td>
                }
                <td>@("৳" + item.Price.ToString("N2"))</td>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <td>
                        @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-sm btn-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.BookId" class="btn btn-sm btn-danger">Delete</a>

                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("Librarian") || User.IsInRole("Staff"))
                        {
                            <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-sm btn-info">Details</a>
                        }
                        @if (User.IsInRole("Member"))
                        {
                            <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-sm btn-info">Details</a>
                            @if (item.AvailableCopies > 0)
                            {
                                <a asp-controller="Borrowings" asp-action="Request" asp-route-id="@item.BookId" class="btn btn-sm btn-primary">Request</a>
                                <a asp-controller="Purchases" asp-action="Buy" asp-route-id="@item.BookId" class="btn btn-sm btn-success">Buy</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-secondary" disabled>Out of Stock</button>
                            }
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>