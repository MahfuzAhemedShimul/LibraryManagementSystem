@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Book Details";
    var comments = ViewBag.Comments as List<LibraryManagementSystem.Models.BookComment> ?? new List<LibraryManagementSystem.Models.BookComment>();
}

<h1>Book Details</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div>
    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Author</dt>
        <dd class="col-sm-9">@Model.Author?.Name</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category?.Name</dd>

        <dt class="col-sm-3">ISBN</dt>
        <dd class="col-sm-9">@Model.ISBN</dd>

        <dt class="col-sm-3">Total Copies</dt>
        <dd class="col-sm-9">@Model.TotalCopies</dd>

        <dt class="col-sm-3">Available Copies</dt>
        <dd class="col-sm-9">@Model.AvailableCopies</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@("৳" + Model.Price.ToString("N2"))</dd>
    </dl>
</div>

@if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Member"))
{
    @if (Model.AvailableCopies > 0)
    {
        <a asp-controller="Borrowings" asp-action="Request" asp-route-id="@Model.BookId" class="btn btn-primary">Request to Borrow</a>
        <a asp-controller="Purchases" asp-action="Buy" asp-route-id="@Model.BookId" class="btn btn-success">Buy This Book</a>
    }
    else
    {
        <button class="btn btn-secondary" disabled>Out of Stock</button>
    }

    @if (!string.IsNullOrEmpty(Model.PdfContent))
    {
        <a asp-controller="OnlineReading" asp-action="Read" asp-route-id="@Model.BookId" class="btn btn-info">Read Online</a>
    }
}

<div class="mt-3">
    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
    {
        <a asp-action="Edit" asp-route-id="@Model.BookId" class="btn btn-secondary">Edit</a>
    }
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</div>

<!-- =========================================
     COMMENTS SECTION
     ========================================= -->
<div class="mt-5">
    <h4>Comments</h4>

    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Member"))
    {
        <form asp-controller="Books" asp-action="PostComment" method="post" class="mb-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bookId" value="@Model.BookId" />
            <div class="form-group mb-2">
                <textarea name="text" class="form-control" rows="3" placeholder="Write a comment about this book..." maxlength="500" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Post Comment</button>
        </form>
    }
    else if (User.Identity == null || !User.Identity.IsAuthenticated)
    {
        <p class="text-muted"><em>Please <a asp-controller="Account" asp-action="Login">log in</a> as a Member to post a comment.</em></p>
    }

    @if (!comments.Any())
    {
        <p><em>No comments yet.</em></p>
    }
    else
    {
        foreach (var c in comments)
        {
            <div class="border-bottom pb-2 mb-2">
                <strong>@(c.Member?.FullName ?? "Unknown Member")</strong>
                <span class="text-muted small">@c.PostedDate.ToString("MMM d, yyyy h:mm tt")</span>
                <p class="mb-0">@c.Text</p>
            </div>
        }
    }
</div>