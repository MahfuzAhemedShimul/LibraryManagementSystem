@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<h1>Book Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Author</dt>
        <dd class="col-sm-9">@Model.Author?.Name</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category?.Name</dd>

        <dt class="col-sm-3">ISBN</dt>
        <dd class="col-sm-9">@Model.ISBN</dd>

        <dt class="col-sm-3">Total Copies</dt>
        <dd class="col-sm-9">@Model.TotalCopies</dd>

        <dt class="col-sm-3">Available Copies</dt>
        <dd class="col-sm-9">@Model.AvailableCopies</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@("৳" + Model.Price.ToString("N2"))</dd>
    </dl>
</div>

@if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Member"))
{
    @if (Model.AvailableCopies > 0)
    {
        <a asp-controller="Purchases" asp-action="Buy" asp-route-id="@Model.BookId" class="btn btn-success">Buy This Book</a>
    }
    else
    {
        <button class="btn btn-secondary" disabled>Out of Stock</button>
    }
}

<div class="mt-3">
    @if (User.IsInRole("Staff"))
    {
        <a asp-action="Edit" asp-route-id="@Model.BookId" class="btn btn-secondary">Edit</a>
    }
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</div>