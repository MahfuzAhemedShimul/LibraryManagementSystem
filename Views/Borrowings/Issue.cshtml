@model LibraryManagementSystem.ViewModels.IssueBookViewModel

@{
    ViewData["Title"] = "Issue a Book";
}

<h1>Issue a Book</h1>

<form asp-action="Issue" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group mb-3">
        <label>Book</label>
        <select asp-for="BookId" class="form-control" asp-items="ViewBag.BookId">
            <option value="">-- Select Book --</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label>Member</label>
        <select asp-for="MemberId" class="form-control" asp-items="ViewBag.MemberId">
            <option value="">-- Select Member --</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="DueDate"></label>
        <input asp-for="DueDate" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Issue Book</button>
</form>

<div class="mt-3"><a asp-action="Index">Back to List</a></div>