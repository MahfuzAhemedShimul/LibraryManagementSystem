@model IEnumerable<LibraryManagementSystem.Models.Borrowing>

@{
    ViewData["Title"] = "My Borrowings";
}

<h1>My Borrowings</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Book</th>
            <th>Issue Date</th>
            <th>Due Date</th>
            <th>Return Date</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var isRequested = item.Status == "Requested";
            var isOverdue = item.Status == "Borrowed" && item.DueDate.Date < DateTime.Today;
            var rowClass = isRequested ? "table-warning" : item.Status == "Rejected" ? "table-secondary" : isOverdue ? "table-danger" : "";
            <tr class="@rowClass">
                <td>@item.Book?.Title</td>
                <td>@(isRequested ? "-" : item.IssueDate.ToShortDateString())</td>
                <td>@(isRequested ? "-" : item.DueDate.ToShortDateString())</td>
                <td>@(item.ReturnDate.HasValue ? item.ReturnDate.Value.ToShortDateString() : "-")</td>
                <td>@(isOverdue ? "Overdue" : item.Status)</td>
            </tr>
        }
    </tbody>
</table>