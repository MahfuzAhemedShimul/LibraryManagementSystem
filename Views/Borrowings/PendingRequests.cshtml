@model LibraryManagementSystem.Models.Borrowing

@{
    ViewData["Title"] = "Approve Request";
}

<h1>Approve Borrow Request</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<dl class="row">
    <dt class="col-sm-3">Book</dt>
    <dd class="col-sm-9">@Model.Book?.Title</dd>
    <dt class="col-sm-3">Member</dt>
    <dd class="col-sm-9">@Model.Member?.FullName</dd>
</dl>

<form asp-action="Approve" method="post">
    <input type="hidden" name="id" value="@Model.BorrowingId" />

    <div class="form-group mb-3">
        <label for="dueDate">Due Date</label>
        <input type="date" name="dueDate" id="dueDate" class="form-control" value="@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")" required />
    </div>

    <button type="submit" class="btn btn-success">Confirm Approval</button>
    <a asp-action="PendingRequests" class="btn btn-secondary">Cancel</a>
</form>