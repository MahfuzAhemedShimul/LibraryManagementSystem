@model IEnumerable<LibraryManagementSystem.Models.Borrowing>

@{
    ViewData["Title"] = "Borrowings";
}

<h1>Borrowings</h1>

<p>
    <a asp-action="Issue" class="btn btn-primary">Issue a Book</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Book</th>
            <th>Member</th>
            <th>Issue Date</th>
            <th>Due Date</th>
            <th>Return Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            var isOverdue = item.Status == "Borrowed"
                && item.DueDate.Date < DateTime.Today;

            <tr class="@(isOverdue ? "table-danger" : "")">

                <td>
                    @item.Book?.Title
                </td>

                <td>
                    @item.Member?.FullName
                </td>

                <td>
                    @item.IssueDate.ToShortDateString()
                </td>

                <td>
                    @item.DueDate.ToShortDateString()
                </td>

                <td>
                    @(item.ReturnDate.HasValue
                        ? item.ReturnDate.Value.ToShortDateString()
                        : "-")
                </td>

                <td>
                    @(isOverdue ? "Overdue" : item.Status)
                </td>

                <td>

                    @* Receipt for completed/active borrowing *@
                    @if (item.Status == "Borrowed" || item.Status == "Returned")
                    {
                        <a asp-action="Receipt"
                           asp-route-id="@item.BorrowingId"
                           class="btn btn-sm btn-primary">
                            🧾 Receipt
                        </a>
                    }

                    @* Return and Renew only for active borrowing *@
                    @if (item.Status == "Borrowed")
                    {
                        <a asp-action="Return"
                           asp-route-id="@item.BorrowingId"
                           class="btn btn-sm btn-success">
                            Return
                        </a>

                        <a asp-action="Renew"
                           asp-route-id="@item.BorrowingId"
                           class="btn btn-sm btn-secondary">
                            Renew
                        </a>
                    }

                </td>
            </tr>
        }
    </tbody>
</table>