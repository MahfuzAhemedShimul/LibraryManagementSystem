@model List<(LibraryManagementSystem.Models.ApplicationUser User, string Role)>

@{
    ViewData["Title"] = "Staff & Librarians";
}

<h1>Staff & Librarians</h1>

<table class="table">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.User.FullName</td>
                <td>@item.User.Email</td>
                <td>
                    <span class="badge bg-@(item.Role == "Admin" ? "danger" : item.Role == "Librarian" ? "primary" : "secondary")">
                        @item.Role
                    </span>
                </td>
            </tr>
        }
    </tbody>
</table>