@model LibraryManagementSystem.Models.Author

@{
    ViewData["Title"] = "Author Details";
}

<h1>Author Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Bio</dt>
        <dd class="col-sm-10">@Model.Bio</dd>
    </dl>
</div>

<div>
    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
    {
        <a asp-action="Edit" asp-route-id="@Model.AuthorId" class="btn btn-secondary">Edit</a>
    }
    <a asp-action="Index">Back to List</a>
</div>